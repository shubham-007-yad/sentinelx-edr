# ===================================================================
# SentinelX EDR Global Environment Variables Blueprint (.env.example)
# Copy this file to '.env' before running docker-compose
# DO NOT COMMIT THE ACTUAL '.env' FILE TO SOURCE CONTROL
# ===================================================================

# Application & Runtime Environment
PROJECT_NAME="SentinelX EDR"
VERSION="1.0.0"
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000

# Security & JWT Authentication
# CRITICAL: Generate a strong 64-character secret in production using `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-secure-random-64-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin & Analyst Credentials (used on first DB seed)
INITIAL_ADMIN_EMAIL=admin@sentinelx.io
INITIAL_ADMIN_PASSWORD=ChangeAdminPass2026!
INITIAL_ANALYST_EMAIL=analyst@sentinelx.io
INITIAL_ANALYST_PASSWORD=ChangeAnalystPass2026!

# PostgreSQL Configuration
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass_2026
POSTGRES_DB=sentinelx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinelx

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_URL=redis://:redis_secure_pass_2026@redis:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# Ports for Nginx Proxy & Frontend
HTTP_PORT=80
HTTPS_PORT=443
VITE_API_BASE_URL=http://localhost/api/v1
