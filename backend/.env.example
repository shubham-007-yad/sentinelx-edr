# ===================================================================
# SentinelX EDR Environment Variables Blueprint (.env.example)
# Copy this file to '.env' for local development and replace secrets.
# ===================================================================

# Application Settings
PROJECT_NAME="SentinelX EDR"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sentinelx

# Direct Database URL (Optional override)
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinelx

# JWT Security & Authentication
# CRITICAL: Generate a strong 64-character secret in production using `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
