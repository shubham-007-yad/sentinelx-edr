# ===================================================================
# SentinelX EDR Backend Environment Variables (.env.example)
# Copy this file to '.env' for local backend development
# ===================================================================

# Application & Runtime Settings
PROJECT_NAME="SentinelX EDR"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000

# Security & JWT Authentication
# In production, set JWT_SECRET or SECRET_KEY to a strong random key
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial DB Seed Credentials
INITIAL_ADMIN_EMAIL=admin@sentinelx.io
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ANALYST_EMAIL=analyst@sentinelx.io
INITIAL_ANALYST_PASSWORD=AnalystPassword123!

# Database Configuration (PostgreSQL)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sentinelx
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinelx

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173
